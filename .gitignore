# Java / Maven
backend/target/
*.class

# Node
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Python
ai-service/venv/
ai-service/__pycache__/
ai-service/**/__pycache__/
ai-service/*.egg-info/
# Trained model IS committed (see ai-service/app/models/demand_model.joblib) — Render builds
# from a fresh git clone with no access to this machine's local training run, so the model
# artifact has to ship in the repo for the deployed ai-service to have anything to load.

# Env files
.env
*.env.local

# Local DB backups/dumps — contain live data, never commit
*.sql
!backend/src/main/resources/db/migration/*.sql

# IDE / OS
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db
