    {
      "name": "Subscriptions",
      "item": [
        {
          "name": "List Subscriptions",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/subscriptions?page=0&size=20&sort=createdAt,desc&status=ACTIVE",
              "host": ["{{baseUrl}}"],
              "path": ["subscriptions"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" },
                { "key": "sort", "value": "createdAt,desc" },
                { "key": "status", "value": "ACTIVE", "disabled": true, "description": "ACTIVE|PAUSED|CANCELLED|EXPIRED" }
              ]
            },
            "description": "Requires: any authenticated user (CUSTOMER sees only their own)."
          }
        },
        {
          "name": "Get Subscription by ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/subscriptions/{{subscriptionId}}", "host": ["{{baseUrl}}"], "path": ["subscriptions", "{{subscriptionId}}"] }
          }
        },
        {
          "name": "Create Subscription",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 1,\n  \"frequency\": \"DAILY\",\n  \"deliveryTimeSlot\": \"morning\",\n  \"startDate\": \"2026-07-20\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/subscriptions", "host": ["{{baseUrl}}"], "path": ["subscriptions"] },
            "description": "Requires: CUSTOMER. `frequency`: DAILY|ALTERNATE_DAY|CUSTOM. For CUSTOM, also send `weekdays` as comma-separated ISO day numbers, e.g. \"1,3,5\" (Mon,Wed,Fri)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('subscriptionId', pm.response.json().data.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Subscription",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"quantity\": 2\n}"
            },
            "url": { "raw": "{{baseUrl}}/subscriptions/{{subscriptionId}}", "host": ["{{baseUrl}}"], "path": ["subscriptions", "{{subscriptionId}}"] },
            "description": "All fields optional: quantity, weekdays, deliveryTimeSlot, endDate."
          }
        },
        {
          "name": "Pause Subscription",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/subscriptions/{{subscriptionId}}/pause", "host": ["{{baseUrl}}"], "path": ["subscriptions", "{{subscriptionId}}", "pause"] }
          }
        },
        {
          "name": "Resume Subscription",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/subscriptions/{{subscriptionId}}/resume", "host": ["{{baseUrl}}"], "path": ["subscriptions", "{{subscriptionId}}", "resume"] }
          }
        },
        {
          "name": "Cancel Subscription",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/subscriptions/{{subscriptionId}}/cancel", "host": ["{{baseUrl}}"], "path": ["subscriptions", "{{subscriptionId}}", "cancel"] }
          }
        },
        {
          "name": "Skip a Delivery Date",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"skipDate\": \"2026-07-25\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/subscriptions/{{subscriptionId}}/skip", "host": ["{{baseUrl}}"], "path": ["subscriptions", "{{subscriptionId}}", "skip"] }
          }
        }
      ]
    },
