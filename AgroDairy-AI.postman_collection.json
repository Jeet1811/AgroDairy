            },
            "url": { "raw": "{{baseUrl}}/animals/{{animalId}}/production", "host": ["{{baseUrl}}"], "path": ["animals", "{{animalId}}", "production"] },
            "description": "Requires: STAFF or ADMIN. `session` is MORNING or EVENING. A statistically abnormal drop vs. this animal's own baseline (needs 7+ prior same-session records) automatically raises an entry on GET /ai/anomalies."
          }
        }
      ]
