            },
            "url": { "raw": "{{baseUrl}}/orders/{{orderId}}/status", "host": ["{{baseUrl}}"], "path": ["orders", "{{orderId}}", "status"] },
            "description": "Requires: STAFF or ADMIN. Forward-only pipeline: PENDING→CONFIRMED→PROCESSING→PACKED→OUT_FOR_DELIVERY→DELIVERED; CANCELLED only from PENDING/CONFIRMED; REFUNDED only from CANCELLED/DELIVERED. Notifies the order owner on every change."
          }
        },
        {
          "name": "Cancel Order",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/orders/{{orderId}}/cancel", "host": ["{{baseUrl}}"], "path": ["orders", "{{orderId}}", "cancel"] },
            "description": "Requires: the order's owner (CUSTOMER, only while PENDING) or STAFF/ADMIN (any pre-DELIVERED status)."
          }
        }
      ]
    },
