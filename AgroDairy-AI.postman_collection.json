{
  "info": {
    "_postman_id": "b8f2a6b0-6e2a-4e3f-9b1a-agrodairyapi01",
    "name": "AgroDairy AI",
    "description": "Full API collection for the AgroDairy AI platform (Spring Boot backend on http://localhost:8080).\n\n## How to use\n1. Import this file into Postman (File → Import).\n2. Run **Auth → Login (Admin seed)** first — its test script automatically saves `accessToken` / `refreshToken` / `userId` as collection variables, so every other request (which inherits Bearer auth from the collection) just works.\n3. To act as STAFF or CUSTOMER, run **Auth → Create Staff Account** (as admin) or **Auth → Register (Customer)**, then **Auth → Login** with those credentials to refresh the saved token.\n4. Requests that create a resource (animal, product, category, batch, order, subscription) auto-save the new id into a collection variable (e.g. `productId`) so the next request in that folder can use it immediately.\n5. All response envelopes are `{ success, data, meta }` on success, or `{ success: false, error: { code, message, details } }` on failure.\n\nDefault seeded login: `admin@agrodairy.local` / `dev-only-admin-change-me` (see docker-compose.yml).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "categoryId", "value": "" },
    { "key": "productId", "value": "" },
    { "key": "animalId", "value": "" },
    { "key": "batchId", "value": "" },
    { "key": "orderId", "value": "" },
    { "key": "subscriptionId", "value": "" },
    { "key": "deliveryId", "value": "" },
    { "key": "notificationId", "value": "" },
    { "key": "anomalyId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register (Customer)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"email\": \"customer1@example.com\",\n  \"password\": \"CustPass123!\",\n  \"fullName\": \"Jane Farmer\",\n  \"phone\": \"+91 98765 43210\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] },
            "description": "Public. Always creates a CUSTOMER-role account."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('accessToken', body.data.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', body.data.refreshToken);",
                  "  pm.collectionVariables.set('userId', body.data.user.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (Admin seed)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"email\": \"admin@agrodairy.local\",\n  \"password\": \"dev-only-admin-change-me\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "description": "Public. Swap the body for any other account's credentials to switch roles."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('accessToken', body.data.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', body.data.refreshToken);",
                  "  pm.collectionVariables.set('userId', body.data.user.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh Token",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/refresh", "host": ["{{baseUrl}}"], "path": ["auth", "refresh"] },
            "description": "Public. Rotates the refresh token — the old one is revoked."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('accessToken', body.data.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', body.data.refreshToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/logout", "host": ["{{baseUrl}}"], "path": ["auth", "logout"] },
            "description": "Public endpoint (revokes the given refresh token). Returns 204 No Content."
          }
        },
        {
          "name": "Get Current User (Me)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] },
            "description": "Requires: any authenticated user."
          }
        },
        {
          "name": "Create Staff/Admin Account",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"email\": \"staff1@agrodairy.local\",\n  \"password\": \"StaffPass123!\",\n  \"fullName\": \"Staff Member\",\n  \"phone\": \"+91 90000 00000\",\n  \"role\": \"STAFF\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/staff", "host": ["{{baseUrl}}"], "path": ["auth", "staff"] },
            "description": "Requires: ADMIN. `role` must be \"STAFF\" or \"ADMIN\". Triggers a WELCOME notification to the new user."
          }
        }
      ]
    },
